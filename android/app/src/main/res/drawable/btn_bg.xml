<?xml version="1.0" encoding="utf-8"?>
<!-- Inset so stacked buttons have a gap; ripple gives tap feedback. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="4dp" android:insetBottom="4dp">
    <ripple android:color="@color/app_rule">
        <item>
            <shape android:shape="rectangle">
                <solid android:color="@color/app_surface" />
                <stroke android:width="1dp" android:color="@color/app_rule" />
                <corners android:radius="6dp" />
            </shape>
        </item>
    </ripple>
</inset>
