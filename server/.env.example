GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Shared secret the phone app sends. Generate with: openssl rand -hex 24
SPEAKEASY_TOKEN=
WHISPER_MODEL=whisper-large-v3
CLEANUP_MODEL=claude-haiku-5-5
LANGUAGE=en
BRAINDUMP_MODEL=claude-sonnet-5-5
# Keep a server-side log of dictations (raw + cleaned) for tuning the dictionary. 0 to turn off.
SAVE_HISTORY=1
