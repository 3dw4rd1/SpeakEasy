GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Shared secret the phone app sends. Generate with: openssl rand -hex 24
SPEAKEASY_TOKEN=
WHISPER_MODEL=whisper-large-v3
# Hear each recording twice (with and without the glossary) and cross-check. 0 = once (half the Groq usage).
SECOND_OPINION=1
# 1 = keep recordings Whisper struggled with in data/audio/ (newest 50) for tuning. Never private fields.
KEEP_HARD_AUDIO=0
CLEANUP_MODEL=claude-haiku-5-5
LANGUAGE=en
BRAINDUMP_MODEL=claude-sonnet-5-5
# Keep a server-side log of dictations (raw + cleaned) for tuning the dictionary. 0 to turn off.
SAVE_HISTORY=1
